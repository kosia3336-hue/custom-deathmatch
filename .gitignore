# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
server/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# 확인용 빌드 산출물 (NEXT_DIST_DIR=.next-verify / .next-mobile)
/.next-verify/
/.next-mobile/
/out/

# production
/build

# server build output
server/dist

# deploy package
/release

# misc
.DS_Store
*.pem
default

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# docs — 개인 기획. UPL7 프리뷰만 추적.
docs/*
!docs/choen/
docs/choen/*
!docs/choen/upl7-preview/

# supabase CLI 프로젝트 디렉터리.
# 슬래시 없이 `supabase` 라고 쓰면 경로 어디에 있든 supabase 라는 이름의
# 디렉터리·파일이 전부 걸린다. 실제로 lib/supabase/ 아래 소스가 조용히
# 누락돼 클린 체크아웃에서 빌드가 깨졌다. 최상위 디렉터리만 무시한다.
/supabase/

# local-only dev previews (skins, UI experiments)
/app/dev/
/public/dev/
# pnpm build 가 app/dev·public/dev 를 잠깐 옮겨 두는 자리
/tmp-app-dev/
/tmp-public-dev/

# Cursor MCP config (contains Supabase access token — do not commit)
/.cursor/mcp.json

# 개인 작업 방식 (choen 전용). 다른 기여자는 쓰지 않는다.
# docs/ 는 ignore. docs/choen/upl7-preview/ 만 예외. 루트 AGENTS.md · logs/ 는 커밋하지 않는다.
/AGENTS.md
/logs/
# 개인 메모·공식전 기보 변환본 (hwpx 원본 포함)
/notes/
# 게임 화면 확인용 fixture (DUMP_FIXTURES=1 로 생성)
tmp-game-fixtures/
public/tmp-fixtures/
