{
  "name": "the-genius-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts && tsup src/socket/games/four-gravity/ai-worker.ts --format esm --outDir dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11",
    "fastify": "^5",
    "socket.io": "^4",
    "uuid": "^11"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/uuid": "^10",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
