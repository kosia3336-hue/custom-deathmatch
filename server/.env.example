# 서버 환경변수 (server/.env 에 복사 후 채우기)

PORT=4001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3001

# Supabase — 서버 전용 (클라이언트 노출 금지)
# Dashboard → Settings → API → Project URL / service_role key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Next.js → 게임 서버 internal endpoint 인증용 공유 시크릿
# .env.local 의 INTERNAL_SECRET 과 동일한 값을 사용해야 함.
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=YOUR-RANDOM-SECRET

# 랭크 더미 타이탄. 1 이면 이번 주 금·토·일 22:00–24:00 KST 큐에 앉음. 로컬 기본 꺼짐.
# DUMMY_LIVE=0

# 해달별 (이벤트) 이번 1회분 — DB event_seasons.id (Next .env.local 과 동일값)
# EVENT_SMS_SEASON_ID=your-event-season-uuid
