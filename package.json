{
  "name": "upl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n front,server -c blue,green \"next dev -p 3001\" \"pnpm --filter the-genius-server dev\"",
    "dev:front": "next dev -p 3001",
    "dev:server": "pnpm --filter the-genius-server dev",
    "build": "next build && pnpm --filter the-genius-server build",
    "assets:cards": "node scripts/compose-numeric-card-images.mjs",
    "assets:playing-cards": "node scripts/compose-playing-cards.mjs",
    "assets:seed-seotda": "node scripts/compose-seed-seotda-cards.mjs",
    "release": "node scripts/make-release.mjs",
    "start": "next start -p 3001",
    "test": "pnpm --filter the-genius-server test",
    "test:watch": "pnpm --filter the-genius-server test:watch",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "./scripts/deploy/release.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.0",
    "@tiptap/extension-image": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.1",
    "pnpm": "^11.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
