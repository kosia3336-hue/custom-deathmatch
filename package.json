{
  "name": "upl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n front,server -c blue,green \"next dev -p 3001\" \"pnpm --filter the-genius-server dev\"",
    "dev:front": "next dev -p 3001",
    "dev:server": "pnpm --filter the-genius-server dev",
    "build": "next build && pnpm --filter the-genius-server build",
    "start": "next start -p 3001",
    "lint": "eslint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
