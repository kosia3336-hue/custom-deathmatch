# ──────────────────────────────────────────────
# 프론트엔드 (Next.js) - NEXT_PUBLIC_ 접두사 필수
# ──────────────────────────────────────────────

# 소켓 서버 URL (API 엔드포인트도 동일 서버 사용)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# 사이트 기본 URL (metadataBase, OG 태그, OAuth 콜백 등에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ──────────────────────────────────────────────
# 서버 (server/.env 에 별도 작성)
# ──────────────────────────────────────────────

# 서버 포트 (기본값: 4001)
PORT=4001

# 서버 바인딩 호스트 (기본값: 0.0.0.0)
HOST=0.0.0.0

# CORS 허용 출처 (콤마로 여러 개 구분)
CORS_ORIGINS=http://localhost:3001

# Supabase (서버 전용)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  # ⚠️ 비밀. 클라이언트 노출 금지

# ──────────────────────────────────────────────
# Next.js 서버 전용 (Route Handler 에서 사용)
# .env.local (로컬) 또는 서버 환경변수로 주입
# ──────────────────────────────────────────────

# Supabase service_role (Next.js 커스텀 OAuth 콜백용)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  # ⚠️ 비밀. 클라이언트 노출 금지

# 카카오 커스텀 OAuth (비즈니스 인증 없이 동작)
# 카카오 Developers → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=YOUR-KAKAO-REST-API-KEY
# 카카오 Developers → 내 애플리케이션 → 보안 → Client Secret
KAKAO_CLIENT_SECRET=YOUR-KAKAO-CLIENT-SECRET  # ⚠️ 비밀

# Next.js → 게임 서버 internal endpoint 인증용 공유 시크릿
# server/.env 의 INTERNAL_SECRET 과 동일한 값을 사용해야 함.
# 생성 방법: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=YOUR-RANDOM-SECRET

# 게임 서버 internal URL (Next.js API → 소켓 서버 직접 호출용)
# 동일 서버라면 http://127.0.0.1:4001 처럼 내부 주소 지정 권장.
# 없으면 NEXT_PUBLIC_SOCKET_URL 이 폴백으로 사용됨.
SOCKET_SERVER_INTERNAL_URL=http://localhost:4001

# 해달별 (이벤트) 이번 1회분 — server/.env 와 동일 UUID
# EVENT_SMS_SEASON_ID=your-event-season-uuid
